{
  "$meta": {
    "name": "Taco Tuesday Consulting — Design Tokens",
    "version": "1.0.0",
    "concept": "Agave & Maiz — Jalisco roots, B2B register",
    "note": "This file is the single source of truth. _tokens.scss and theme.css are derived from it."
  },

  "palette": {
    "agave": {
      "50":  "#ECF7F4", "100": "#D0EDE6", "200": "#A3DACE", "300": "#6FC2B2",
      "400": "#41A695", "500": "#22897A", "600": "#176E63", "700": "#12574F",
      "800": "#0F453F", "900": "#0C3833", "950": "#06211E"
    },
    "maiz": {
      "50":  "#FDF6E9", "100": "#FAE9C6", "200": "#F5D28C", "300": "#EEB74E",
      "400": "#E5A020", "500": "#C98314", "600": "#A26610", "700": "#7E4F10",
      "800": "#5E3B0E", "900": "#452C0C", "950": "#241605"
    },
    "barro": {
      "0":   "#FFFFFF", "25":  "#FBFAF8", "50":  "#F6F4F1", "100": "#EDEAE5",
      "200": "#DDD8D0", "300": "#C3BCB1", "400": "#A0968A", "500": "#7E7468",
      "600": "#625A50", "700": "#4B443C", "800": "#332E29", "900": "#211E1A",
      "950": "#14120F"
    },
    "semantic": {
      "success": "#1E7F53", "successSubtle": "#E6F4EC",
      "warning": "#C98314", "warningSubtle": "#FDF6E9",
      "danger":  "#BC3B2E", "dangerSubtle":  "#FBEDEB",
      "info":    "#35688F", "infoSubtle":    "#EAF1F7"
    }
  },

  "theme": {
    "light": {
      "bg-canvas": "barro.25", "bg-surface": "barro.0", "bg-subtle": "barro.50",
      "bg-inset": "barro.100", "bg-inverse": "barro.900",
      "border": "barro.200", "border-strong": "barro.300",
      "text-primary": "barro.900", "text-secondary": "barro.600",
      "text-muted": "barro.500", "text-inverse": "barro.25",
      "brand": "agave.600", "brand-hover": "agave.700", "brand-active": "agave.800",
      "brand-subtle": "agave.50", "brand-border": "agave.200",
      "on-brand": "barro.0", "brand-text": "agave.700",
      "accent": "maiz.500", "accent-subtle": "maiz.50", "on-accent": "barro.0",
      "focus": "agave.400", "overlay": "rgba(33, 30, 26, 0.48)"
    },
    "dark": {
      "bg-canvas": "barro.950", "bg-surface": "barro.900", "bg-subtle": "barro.800",
      "bg-inset": "barro.800", "bg-inverse": "barro.50",
      "border": "#3B3630", "border-strong": "barro.700",
      "text-primary": "barro.50", "text-secondary": "barro.300",
      "text-muted": "barro.400", "text-inverse": "barro.950",
      "brand": "agave.300", "brand-hover": "agave.200", "brand-active": "agave.100",
      "brand-subtle": "agave.950", "brand-border": "agave.800",
      "on-brand": "agave.950", "brand-text": "agave.300",
      "accent": "maiz.300", "accent-subtle": "maiz.950", "on-accent": "maiz.950",
      "focus": "agave.300", "overlay": "rgba(6, 33, 30, 0.64)"
    }
  },

  "typography": {
    "family": {
      "display": "'Outfit', 'Segoe UI', system-ui, sans-serif",
      "body": "'Inter', 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Cascadia Code', ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
      "xl": "1.25rem", "2xl": "1.5rem", "3xl": "1.875rem", "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "leading": { "tight": 1.2, "snug": 1.35, "normal": 1.55, "relaxed": 1.7 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.04em" }
  },

  "space": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
    "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem"
  },
  "radius": {
    "none": "0", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(33,30,26,.06), 0 1px 1px rgba(33,30,26,.04)",
    "md": "0 4px 12px rgba(33,30,26,.08), 0 1px 3px rgba(33,30,26,.06)",
    "lg": "0 12px 32px rgba(33,30,26,.12), 0 2px 8px rgba(33,30,26,.06)"
  },
  "motion": {
    "fast": "120ms", "base": "200ms", "slow": "320ms",
    "ease": "cubic-bezier(.2,0,.15,1)"
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
